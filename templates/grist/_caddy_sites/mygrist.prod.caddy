# DAPS Grist Template — Prod Caddy Config
# This file is imported by the root DAPS Caddyfile on the remote VM.
# Caddy will automatically obtain and renew a TLS certificate for your domain.
#
# SETUP:
#   1. Replace "mygrist.example.com" with your actual domain name.
#   2. Replace "admin" with your chosen username.
#   3. Replace the hash with one generated for your password:
#      docker run --rm caddy:latest caddy hash-password --plaintext 'yourpassword'
#   4. Point your domain's DNS A record at your server's IP address. Caddy requests the
#      certificate when it starts, and Let's Encrypt only issues it once that record
#      resolves — see "DNS and HTTPS" in daps/docs/readme-deployment.md for whether to
#      do this before or after deploying.

mygrist.example.com {
	encode gzip zstd
	basicauth {
		admin $2a$14$REPLACEME_RUN_CADDY_HASH_PASSWORD_TO_GENERATE_THIS_HASH
	}
	reverse_proxy mygrist:8484
}
